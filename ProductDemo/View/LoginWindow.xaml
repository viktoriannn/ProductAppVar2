<Window x:Class="ProductDemo.View.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProductDemo.View"
        mc:Ignorable="d"
        Title="Вход" Height="450" Width="800">
    <Grid>
        <StackPanel Width="200" Height="200">
            <Image Source="/Res/Icon.JPG" Width="50" Height="50"/>
            <TextBlock Text="Логин:" Margin="2"/>
            <TextBox Name="loginTxt" />
            <TextBlock Text="Пароль:" Margin="2"/>
            <PasswordBox Name="passwordTxt" />
            <Button Content="Войти" Name="LogBtn" Click="LogBtn_Click" Margin="2"/>
            <TextBlock Text="Войти как гость" HorizontalAlignment="Center" MouseDown="TextBlock_MouseDown"/>
        </StackPanel>
    </Grid>
</Window>
