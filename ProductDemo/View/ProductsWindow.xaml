<Window x:Class="ProductDemo.ProductsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProductDemo"
        mc:Ignorable="d"
        Title="Товары" Height="450" Width="800">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Image Source="/Res/Icon.JPG" Width="50" Height="50" HorizontalAlignment="Left"/>

        <Grid Grid.Row="0" Margin="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Name="userNameTxt" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="4"/>
            <Button Grid.Column="1" Content="Выйти" Name="LogOutBtn" Click="LogOutBtn_Click" VerticalAlignment="Center" Height="30" Width="80" Margin="3" Background="#00FA9A"/>
            <Button Grid.Column="2" Content="Заказы" Name="OrderOutBtn" Click="OrderOutBtn_Click"  VerticalAlignment="Center" Height="30" Width="80" Margin="3" Visibility="Collapsed"/>
        </Grid>

        <Grid Grid.Row="1" Name="panelFind" Visibility="Collapsed" Margin="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Поиск" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" Name="FindTxt" Width="200" Margin="3" VerticalAlignment="Center" TextChanged="FindTxt_TextChanged"/>
            <TextBlock Grid.Column="2" Text="Фильтр" VerticalAlignment="Center"/>
            <ComboBox Grid.Column="3" Name="FilterBox" Width="150" Margin="3" VerticalAlignment="Center" SelectionChanged="FilterBox_SelectionChanged"/>
            <TextBlock Grid.Column="4" Text="Сортировка" VerticalAlignment="Center"/>
            <ComboBox Grid.Column="5" Name="SortBox" Width="150" Margin="3" VerticalAlignment="Center" SelectionChanged="SortBox_SelectionChanged"/>
        </Grid>

        <TextBlock Grid.Row="2" Text="Ничего не найдено" Name="resultTxt" HorizontalAlignment="Center" Visibility="Collapsed" Foreground="#00FA9A"/>
        <ScrollViewer Grid.Row="3">
            <ItemsControl Name="productList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="10" Name="ProductCard" Background="{Binding Background}" MouseDown="ProductCard_MouseDown">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Height="80" Width="80" Margin="10">
                                    <Image Source="{Binding Photo}"/>
                                </Border>
                                <StackPanel Margin="4" Grid.Column="1">
                                    <TextBlock FontWeight="Bold" TextWrapping="Wrap">
                                        <Run Text="{Binding Category}"/>
                                        <Run Text=" | "/>
                                        <Run Text="{Binding ProductType}"/>
                                    </TextBlock>
                                    <TextBlock TextWrapping="Wrap">
                                        <Run Text="Описание товара: "/>
                                        <Run Text="{Binding Description}"/>
                                    </TextBlock>
                                    <TextBlock>
                                        <Run Text="Производитель: "/>
                                        <Run Text="{Binding Production}"/>
                                    </TextBlock>
                                    <TextBlock>
                                        <Run Text="Поставщик: "/>
                                        <Run Text="{Binding Provider}"/>
                                    </TextBlock>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Цена: "/>
                                        <TextBlock Text="{Binding Price, StringFormat={}{0:N2} руб.}" Foreground="Red" TextDecorations="Strikethrough" Margin="0,0,6,0" Visibility="{Binding DiscountVisibility}"/>
                                        <TextBlock Text="{Binding FinalPrice, StringFormat={}{0:N2} руб.}" Foreground="Black"/>
                                    </StackPanel>
                                    <TextBlock>
                                        <Run Text="Единица измерения: "/>
                                        <Run Text="{Binding Unit}"/>
                                    </TextBlock>
                                    <TextBlock>
                                        <Run Text="Количество на складе: "/>
                                        <Run Text="{Binding Count}"/>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center" Grid.Column="2">
                                    <TextBlock Text="Скидка" TextAlignment="Center" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding DiscountText}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <Button Content="Удалить" Background="#00FA9A" Name="DelBtn" Click="DelBtn_Click" Margin="3,8,3,0" Visibility="{Binding DeleteVisibility}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Grid Grid.Row="4">
            <StackPanel Name="paneAddDel" Visibility="Collapsed">
                <Button Content="Добавить товар" Name="AddBtn" Click="AddBtn_Click" Margin="3"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
