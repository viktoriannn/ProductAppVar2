<Window x:Class="ProductDemo.View.OrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProductDemo.View"
        mc:Ignorable="d"
        Title="Заказы" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Image Source="/Res/Icon.JPG" Width="50" Height="50" HorizontalAlignment="Left" Margin="3"/>

        <Grid Grid.Row="0" Margin="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Name="userNameTxt" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="4"/>
            <Button Grid.Column="1" Content="Назад" Name="BackBtn" Click="BackBtn_Click" Background="#00FA9A" VerticalAlignment="Center" Height="30" Width="80" Margin="3"/>
            <Button Grid.Column="2" Content="Выйти" Name="LogOutBtn" Click="LogOutBtn_Click" VerticalAlignment="Center" Height="30" Width="80" Margin="3"/>
        </Grid>

        <ScrollViewer Grid.Row="2">
            <ItemsControl Name="orderList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="10" Name="OrderCard" MouseDown="OrderCard_MouseDown">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="140"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="6" Grid.Column="0">
                                    <TextBlock FontWeight="Bold">
                                        <Run Text="Заказ №"/>
                                        <Run Text="{Binding Id}"/>
                                        <Run Text=" | Код получения: "/>
                                        <Run Text="{Binding Code}"/>
                                    </TextBlock>
                                    <TextBlock>
                                        <Run Text="Статус: "/>
                                        <Run Text="{Binding Status}"/>
                                    </TextBlock>
                                    <TextBlock>
                                        <Run Text="Дата заказа: "/>
                                        <Run Text="{Binding DataOrderText,  Mode=OneWay}"/>
                                        <Run Text="   Дата доставки: "/>
                                        <Run Text="{Binding DataDeliveryText,  Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock TextWrapping="Wrap">
                                        <Run Text="Пункт выдачи: "/>
                                        <Run Text="{Binding Pvz}"/>
                                    </TextBlock>
                                    <TextBlock>
                                        <Run Text="Клиент: "/>
                                        <Run Text="{Binding Client}"/>
                                    </TextBlock>
                                    <TextBlock TextWrapping="Wrap">
                                        <Run Text="Состав заказа: "/>
                                        <Run Text="{Binding Composition}"/>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center" Grid.Column="1">
                                    <TextBlock Text="Итого" TextAlignment="Center" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Total, StringFormat={}{0:N2} руб.}" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <Button Content="Удалить" Background="#00FA9A" Name="DelBtn" Click="DelBtn_Click" Margin="3,8,3,0" Visibility="{Binding DeleteVisibility}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Grid Grid.Row="3">
            <StackPanel Name="paneAddDel" Visibility="Collapsed">
                <Button Content="Оформить заказ" Name="AddBtn" Click="AddBtn_Click" Margin="3"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>